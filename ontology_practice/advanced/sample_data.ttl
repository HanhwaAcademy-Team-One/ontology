@prefix ex: <https://example.org/cafe-ops#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

ex:Korea a ex:Country ; rdfs:label "대한민국" .
ex:Seoul a ex:City ; rdfs:label "서울" ; ex:partOf ex:Korea .
ex:Gangnam a ex:District ; rdfs:label "강남구" ; ex:partOf ex:Seoul .
ex:GangnamStore a ex:Store ; rdfs:label "강남점" ; ex:locatedIn ex:Gangnam ;
    ex:offers ex:Americano, ex:OatLatte, ex:MilkLatte, ex:MatchaLatte, ex:SesameCookie .

# 고객은 가상의 실습용 프로필입니다. 금액은 원, 재료량은 g 단위입니다.
ex:Minsu a ex:Customer ; rdfs:label "민수" ; ex:veganOnly true ;
    ex:avoidCaffeine false ; ex:budget 5000 ; ex:avoidsAllergen ex:MilkAllergen, ex:SesameAllergen .
ex:Jisu a ex:Customer ; rdfs:label "지수" ; ex:veganOnly false ;
    ex:avoidCaffeine true ; ex:budget 6000 .

ex:MilkAllergen a ex:Allergen ; rdfs:label "우유" .
ex:SesameAllergen a ex:Allergen ; rdfs:label "참깨" .
ex:GlutenAllergen a ex:Allergen ; rdfs:label "글루텐" .
ex:BeanSupplier a ex:Supplier ; rdfs:label "원두 공급사" .
ex:PlantSupplier a ex:Supplier ; rdfs:label "식물성 재료 공급사" .
ex:DairySupplier a ex:Supplier ; rdfs:label "유제품 공급사" .

# profileComplete는 예제 안에서 재료 프로필을 모두 입력했다는 명시적 표시입니다.
# ingredientCaffeine 값으로부터 CaffeinatedIngredient 타입을 추론합니다.
ex:Coffee a ex:PlantIngredient ; rdfs:label "원두" ;
    ex:isVegan true ; ex:ingredientCaffeine true ; ex:profileComplete true ; ex:suppliedBy ex:BeanSupplier .
ex:Water a ex:PlantIngredient ; rdfs:label "물" ;
    ex:isVegan true ; ex:ingredientCaffeine false ; ex:profileComplete true ; ex:suppliedBy ex:PlantSupplier .
ex:OatMilk a ex:PlantIngredient ; rdfs:label "귀리 음료" ;
    ex:isVegan true ; ex:ingredientCaffeine false ; ex:profileComplete true ; ex:suppliedBy ex:PlantSupplier .
ex:Milk a ex:AnimalIngredient ; rdfs:label "우유" ;
    ex:isVegan false ; ex:ingredientCaffeine false ; ex:profileComplete true ; ex:hasAllergen ex:MilkAllergen ; ex:suppliedBy ex:DairySupplier .
ex:Matcha a ex:PlantIngredient ; rdfs:label "말차" ;
    ex:isVegan true ; ex:ingredientCaffeine true ; ex:profileComplete true ; ex:suppliedBy ex:PlantSupplier .
ex:Flour a ex:PlantIngredient ; rdfs:label "밀가루" ;
    ex:isVegan true ; ex:ingredientCaffeine false ; ex:profileComplete true ; ex:hasAllergen ex:GlutenAllergen ; ex:suppliedBy ex:PlantSupplier .
ex:Sesame a ex:PlantIngredient ; rdfs:label "참깨" ;
    ex:isVegan true ; ex:ingredientCaffeine false ; ex:profileComplete true ; ex:hasAllergen ex:SesameAllergen ; ex:suppliedBy ex:PlantSupplier .

ex:Americano a ex:CoffeeDrink ; rdfs:label "아메리카노" ; ex:menuPrice 3000 ; ex:hasRecipe ex:AmericanoRecipe .
ex:OatLatte a ex:CoffeeDrink ; rdfs:label "귀리 라테" ; ex:menuPrice 4500 ; ex:hasRecipe ex:OatLatteRecipe .
ex:MilkLatte a ex:CoffeeDrink ; rdfs:label "우유 라테" ; ex:menuPrice 4300 ; ex:hasRecipe ex:MilkLatteRecipe .
ex:MatchaLatte a ex:Beverage ; rdfs:label "말차 라테" ; ex:menuPrice 5000 ; ex:hasRecipe ex:MatchaRecipe .
ex:SesameCookie a ex:Food ; rdfs:label "참깨 쿠키" ; ex:menuPrice 2500 ; ex:hasRecipe ex:CookieRecipe .

ex:AmericanoRecipe a ex:Recipe ; ex:hasRequirement ex:A_Coffee, ex:A_Water .
ex:OatLatteRecipe a ex:Recipe ; ex:hasRequirement ex:O_Coffee, ex:O_OatMilk .
ex:MilkLatteRecipe a ex:Recipe ; ex:hasRequirement ex:M_Coffee, ex:M_Milk .
ex:MatchaRecipe a ex:Recipe ; ex:hasRequirement ex:T_Matcha, ex:T_OatMilk .
ex:CookieRecipe a ex:Recipe ; ex:hasRequirement ex:C_Flour, ex:C_OatMilk, ex:C_Sesame .
ex:A_Coffee a ex:RecipeRequirement ; ex:ingredient ex:Coffee ; ex:requiredGrams "18"^^xsd:decimal .
ex:A_Water a ex:RecipeRequirement ; ex:ingredient ex:Water ; ex:requiredGrams "200"^^xsd:decimal .
ex:O_Coffee a ex:RecipeRequirement ; ex:ingredient ex:Coffee ; ex:requiredGrams "18"^^xsd:decimal .
ex:O_OatMilk a ex:RecipeRequirement ; ex:ingredient ex:OatMilk ; ex:requiredGrams "200"^^xsd:decimal .
ex:M_Coffee a ex:RecipeRequirement ; ex:ingredient ex:Coffee ; ex:requiredGrams "18"^^xsd:decimal .
ex:M_Milk a ex:RecipeRequirement ; ex:ingredient ex:Milk ; ex:requiredGrams "200"^^xsd:decimal .
ex:T_Matcha a ex:RecipeRequirement ; ex:ingredient ex:Matcha ; ex:requiredGrams "5"^^xsd:decimal .
ex:T_OatMilk a ex:RecipeRequirement ; ex:ingredient ex:OatMilk ; ex:requiredGrams "200"^^xsd:decimal .
ex:C_Flour a ex:RecipeRequirement ; ex:ingredient ex:Flour ; ex:requiredGrams "40"^^xsd:decimal .
ex:C_OatMilk a ex:RecipeRequirement ; ex:ingredient ex:OatMilk ; ex:requiredGrams "10"^^xsd:decimal .
ex:C_Sesame a ex:RecipeRequirement ; ex:ingredient ex:Sesame ; ex:requiredGrams "5"^^xsd:decimal .

# 매장/재료마다 재고 레코드는 하나입니다. 중복은 SHACL에서 검사합니다.
ex:StockCoffee a ex:StockEntry ; ex:stockStore ex:GangnamStore ; ex:stockIngredient ex:Coffee ; ex:availableGrams "80"^^xsd:decimal .
ex:StockWater a ex:StockEntry ; ex:stockStore ex:GangnamStore ; ex:stockIngredient ex:Water ; ex:availableGrams "1000"^^xsd:decimal .
ex:StockOat a ex:StockEntry ; ex:stockStore ex:GangnamStore ; ex:stockIngredient ex:OatMilk ; ex:availableGrams "300"^^xsd:decimal .
ex:StockMilk a ex:StockEntry ; ex:stockStore ex:GangnamStore ; ex:stockIngredient ex:Milk ; ex:availableGrams "1000"^^xsd:decimal .
ex:StockMatcha a ex:StockEntry ; ex:stockStore ex:GangnamStore ; ex:stockIngredient ex:Matcha ; ex:availableGrams "0"^^xsd:decimal .
ex:StockFlour a ex:StockEntry ; ex:stockStore ex:GangnamStore ; ex:stockIngredient ex:Flour ; ex:availableGrams "200"^^xsd:decimal .
ex:StockSesame a ex:StockEntry ; ex:stockStore ex:GangnamStore ; ex:stockIngredient ex:Sesame ; ex:availableGrams "10"^^xsd:decimal .
